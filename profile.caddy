# Halaman profil di domain utama, dilayani edge Caddy bersama (stack LedgerPay) di VM yang sama.
# deploy.sh menyalin file ini + folder site/ ke /srv/edge/sites/ (di container: /etc/caddy/sites/).
suyantolabs.my.id, www.suyantolabs.my.id {
	@www host www.suyantolabs.my.id
	redir @www https://suyantolabs.my.id{uri} permanent

	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self' data:; media-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	log {
		output stdout
		format json
	}
	root * /etc/caddy/sites/profile
	file_server
}
